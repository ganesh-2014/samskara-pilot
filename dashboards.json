          "id": "2b45fbf5-9447-4772-bf13-944f010479c1",
          "title": "Extreme Weather Alerts",
          "chart_type": "table",
          "sql_query": "SELECT\n    state_name,\n    city_name,\n    forecast_time,\n    temperature_2m,\n    precipitation,\n    wind_speed\nFROM weather.bronze.bronze_weather_hourly\nWHERE\n    temperature_2m > 40\n    OR precipitation > 20\n    OR wind_speed > 35\nORDER BY forecast_time;",
          "connection_id": "f9400931-7519-4e17-9a25-addeb6b8a85f",
          "connection_name": null,
          "refresh_interval_seconds": 0,
          "position_order": 0,
