          "chart_type": "area",
          "sql_query": "SELECT\n    forecast_time,\n    AVG(wind_speed) AS avg_wind_speed\nFROM weather.bronze.bronze_weather_hourly\nGROUP BY forecast_time\nORDER BY forecast_time;",
